# LLM backend (OpenAI-compatible). Swap base_url for vLLM/Ollama/Anthropic-compatible/etc.
OPENAI_API_KEY=sk-replace-me
OPENAI_BASE_URL=https://api.openai.com/v1
SKILLTREND_MODEL=gpt-4o-mini

# Pipeline knobs
SKILLTREND_WORKERS=4
SKILLTREND_MAX_POSTINGS_PER_COMPANY=50
# Client-side requests-per-minute cap (0 = unlimited).
# Use this on free-tier APIs (e.g. Gemini flash-lite is 10 RPM); set 0 on
# paid tier where the backend queues for you.
SKILLTREND_RPM=0

# Data directory (defaults to ./data). Override for docker volume mount.
SKILLTREND_DATA_DIR=./data

# If true, the extractor will skip real LLM calls and return a deterministic
# offline result. Useful for local smoke tests without API credit.
SKILLTREND_FAKE_LLM=false
